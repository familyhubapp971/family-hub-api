# ============================================================
#  Family Hub: settings template
#  Copy to .env.local at the repo root and fill it in.
#  NEVER put real secrets in this file: it is committed.
#  Real values live in .env.local (local) and Railway (deployed).
# ============================================================


# ------------------------------------------------------------
#  RUNTIME
# ------------------------------------------------------------

NODE_ENV=development                    # development | staging | production
PORT=3001                               # api port locally
LOG_LEVEL=info                          # debug | info | warn | error


# ------------------------------------------------------------
#  DOMAIN AND SECURITY
# ------------------------------------------------------------

# localhost here, staging.familyhub.app on staging, familyhub.app in production
BASE_DOMAIN=localhost
VITE_API_URL=http://localhost:3001      # where the web app finds the api

# Extra allowed origins, comma-separated. Empty = worked out from BASE_DOMAIN.
# CORS_ALLOWED_ORIGINS=

# Requests per IP per minute. 0 turns it off (test runs).
# RATE_LIMIT_PER_MINUTE=100


# ------------------------------------------------------------
#  DATABASE  (Postgres)
# ------------------------------------------------------------

# Local Docker database (pnpm dev:up). Railway sets its own.
DATABASE_URL=postgres://familyhub:familyhub@localhost:5432/familyhub_dev

# Test database for the integration tests
# DATABASE_URL_TEST=postgres://fh_test:fh_test@localhost:5433/familyhub_test


# ------------------------------------------------------------
#  SUPABASE  (sign-in)
# ------------------------------------------------------------

# Paste real values, not $VAR references: most loaders do not expand them.
# Values: Supabase dashboard > Project Settings > API.

# Account token for the management API (supabase.com/dashboard/account/tokens)
# SUPABASE_ACCESS_TOKEN=

# What the api actually reads. Point at staging for local work.
# SUPABASE_URL=https://maolytpqazmykjzdybtj.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=            # server only, never in the web app

# ------------------------------------------------------------
#  GOTRUE  (our own sign-in server, replacing Supabase: FHS-676)
# ------------------------------------------------------------
# Unset, sign-in stays on Supabase. Staging sets all three.
# GOTRUE_URL=http://gotrue.railway.internal:9999                 # turns on /auth/v1
# AUTH_JWKS_URL=http://gotrue.railway.internal:9999/.well-known/jwks.json
# AUTH_ISSUER=https://fh-api-staging.up.railway.app/auth/v1     # set with AUTH_JWKS_URL
# Per-email limits on /auth/v1 (defaults shown)
# SIGNIN_MAX_FAILED_ATTEMPTS=5
# SIGNIN_LOCKOUT_MS=900000
# SIGNIN_EMAILS_PER_HOUR=5

# What the web app reads. Browser-safe keys only, never a secret.
# VITE_SUPABASE_URL=https://maolytpqazmykjzdybtj.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=        # optional

# Staging project (maolytpqazmykjzdybtj), for local reference only
# SUPABASE_URL_STAGING=https://maolytpqazmykjzdybtj.supabase.co
# SUPABASE_ANON_KEY_STAGING=
# SUPABASE_SERVICE_ROLE_KEY_STAGING=
# SUPABASE_PUBLISHABLE_KEY_STAGING=
# SUPABASE_SECRET_KEY_STAGING=
# SUPABASE_DB_PASSWORD_STAGING=

# Production project (bqghmbkoxjompuxixexn), for local reference only
# SUPABASE_URL_PRODUCTION=https://bqghmbkoxjompuxixexn.supabase.co
# SUPABASE_ANON_KEY_PRODUCTION=
# SUPABASE_SERVICE_ROLE_KEY_PRODUCTION=
# SUPABASE_PUBLISHABLE_KEY_PRODUCTION=
# SUPABASE_SECRET_KEY_PRODUCTION=

# Only for running sign-in without Supabase (openssl rand -base64 48)
# AUTH_SECRET=


# ------------------------------------------------------------
#  FOUNDER FEEDBACK PAGE  (/admin)
# ------------------------------------------------------------

# 6 to 12 digits. Empty = the page is switched off.
# FOUNDER_PASSCODE=

# Long random secret that signs the page pass (openssl rand -base64 48).
# Needed on deployed servers; local dev has a built-in one.
# FOUNDER_TOKEN_SECRET=


# ------------------------------------------------------------
#  EMAIL  (Resend)
# ------------------------------------------------------------

# Sends the "confirm your new sign-in email" link (resend.com/api-keys)
# RESEND_API_KEY=                       # re_...
# RESEND_FROM_EMAIL=noreply@fhapp.co
# RESEND_FROM_NAME=FamilyHub


# ------------------------------------------------------------
#  PAYMENTS  (Stripe)
# ------------------------------------------------------------

# Stripe dashboard > Developers > API keys (test mode for dev)
# STRIPE_SECRET_KEY=                    # sk_test_... / sk_live_...
# STRIPE_WEBHOOK_SECRET=                # whsec_...
# STRIPE_PUBLISHABLE_KEY=               # pk_test_...


# ------------------------------------------------------------
#  ERROR TRACKING  (Sentry)
# ------------------------------------------------------------

# Sentry > Project Settings > Client Keys. Empty = nothing is sent.
# SENTRY_DSN_API=
# VITE_SENTRY_DSN_WEB=
# SENTRY_TRACES_SAMPLE_RATE=0.1         # 0 to 1
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Set by CI and Railway, not locally
# SENTRY_RELEASE=
# VITE_SENTRY_RELEASE=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT_WEB=


# ------------------------------------------------------------
#  AI MATHS LESSONS  (Anthropic)
# ------------------------------------------------------------

# Off by default. Off = the kids get the built-in Maths questions.
# LEARN_AI_ENABLED=false
# ANTHROPIC_API_KEY=                    # sk-ant-... (console.anthropic.com)


# ------------------------------------------------------------
#  JIRA  (scripts only, not the app)
# ------------------------------------------------------------

# Token from id.atlassian.com/manage-profile/security/api-tokens
# EMAIL=you@example.com
# JIRA_API_TOKEN=
# URL=https://qualicion2.atlassian.net/


# ------------------------------------------------------------
#  HOSTING  (Railway)
# ------------------------------------------------------------

# Account token from railway.com/account/tokens
# RAILWAY_API_TOKEN=


# ------------------------------------------------------------
#  TESTS
# ------------------------------------------------------------

# Test-only user on Supabase staging. Never use it for real work.
# E2E_USER_EMAIL=e2e@familyhub.test
# E2E_USER_PASSWORD=


# ------------------------------------------------------------
#  SITE PASSCODE CURTAIN  (retired)
# ------------------------------------------------------------

# "off" takes the old tester passcode screen down. Off locally anyway.
# VITE_ENV_LOCK=off
