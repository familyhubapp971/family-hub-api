{
  "name": "@familyhub/api",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for families. Monorepo root.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "volta": {
    "node": "20.19.0",
    "pnpm": "10.32.0"
  },
  "scripts": {
    "dev": "sh -c '([ -f .env.local ] && tsx watch --env-file=.env.local src/index.ts) || tsx watch src/index.ts'",
    "start": "sh ./scripts/server/start.sh",
    "build": "tsc --noEmit && node build.mjs",
    "openapi:generate": "tsx scripts/server/generate-openapi.ts",
    "openapi:check": "tsx scripts/server/check-openapi.ts",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "tsx --env-file=.env.local src/database/seed.ts",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "dev:up": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && docker compose up -d --wait",
    "seed": "./scripts/seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "pnpm test:db:up",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:integration:watch": "vitest --config tests/integration/vitest.config.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "perf:smoke": "tests/performance/bin/run-k6.sh tests/performance/scenarios/smoke.js",
    "perf:smoke:auth": "tests/performance/bin/run-k6.sh tests/performance/scenarios/auth-smoke.js",
    "perf:load": "tests/performance/bin/run-k6.sh tests/performance/scenarios/load.js",
    "perf:stress": "tests/performance/bin/run-k6.sh tests/performance/scenarios/stress.js",
    "perf:soak": "tests/performance/bin/run-k6.sh tests/performance/scenarios/soak.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "prepare": "husky || true",
    "feedback:export": "node scripts/data/export-beta-feedback.mjs"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^6.3.0",
    "@eslint/js": "9.18.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/node": "20.16.11",
    "@types/pg": "8.11.10",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/coverage-v8": "2.1.4",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.36.1",
    "esbuild": "0.23.1",
    "eslint": "9.18.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "hono": "4.6.10",
    "husky": "9.1.7",
    "jose": "^5.10.0",
    "jsdom": "25.0.1",
    "lint-staged": "15.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "8.13.1",
    "pino-pretty": "^13.1.3",
    "prettier": "3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.4"
  },
  "packageManager": "pnpm@10.32.0",
  "dependencies": {
    "@familyhub/shared": "workspace:*",
    "@hono/node-server": "1.13.7",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "0.4.1",
    "@sentry/node": "^8.55.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.36.1",
    "hono": "4.6.10",
    "jose": "^5.10.0",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "zod": "3.23.8",
    "zod-to-json-schema": "^3.23.5"
  }
}
